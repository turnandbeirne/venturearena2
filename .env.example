# VentureArena settings. This file lists the NAMES and what they do.
# Real values go in your host's dashboard (Render / Railway "Environment"),
# never in a file in the repository. For local work, copy this to `.env.local`
# (git-ignored) and load it with:  node --env-file=.env.local build/server.cjs
#
# Everything is optional. With nothing set, the server runs on port 8000 with
# storage in memory.

# ---- where the site lives ----------------------------------------------------
# The public address, no trailing slash. Used in emails, invite links, SEO pages
# and to decide which browsers may connect. Render and Railway set their own
# variable for this; set PUBLIC_URL once you have a custom domain.
# PUBLIC_URL=https://arena.venturemaker.org
# PORT=8000
# Set by the host in production. Turns on Secure cookies and proxy headers.
# NODE_ENV=production

# How many proxies sit between the internet and the server (Render: 1,
# Railway: 1; add 1 if Cloudflare is in front). Without it the per-address
# rate limits can be dodged with a made-up X-Forwarded-For header.
# TRUSTED_PROXY_HOPS=1

# Sockets are only accepted from pages served by this site: the page's address
# must match the address the request was sent to, or PUBLIC_URL. If a proxy in
# front rewrites the Host header, list the site's addresses here (comma separated).
# ALLOWED_ORIGINS=https://arena.venturemaker.org,https://www.venturemaker.org

# A playtest or staging copy: tell search engines to stay away.
# NOINDEX=1

# ---- storage (pick one; with neither, everything is lost on restart) ---------
# Any Postgres. For Supabase: Project Settings > Database > Connection string
# ("Session pooler"). The server creates its one table (va_docs) on first start.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# When the database is shared with another application, keep this server's one
# table in a schema of its own (README: "Sharing a Supabase project").
# DATABASE_SCHEMA=arena2
# Or a single JSON file on a persistent disk (fine for a pilot).
# DATA_FILE=/data/arena.json

# ---- operator ---------------------------------------------------------------
# A long random string. Enables POST /api/admin/* and `npm run admin`.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_TOKEN=

# ---- email (Resend) -----------------------------------------------------------
# Without a key no email is sent: new accounts are treated as verified, and
# password reset links are made by the operator (`npm run admin -- reset-link`).
# RESEND_API_KEY=
# MAIL_FROM=VentureArena <arena@venturemaker.org>

# ---- billing (Stripe) -------------------------------------------------------
# Until the secret key and PRICE_MEMBER are set, the Membership page collects a
# waitlist instead of taking payment.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Price ids of three monthly subscriptions: $9.99, $49 and $249.
# PRICE_MEMBER=
# PRICE_VIP=
# PRICE_CEO=

# ---- behaviour (defaults shown) ---------------------------------------------
# Lock VentureFlow's fine-grained settings to subscribers and above.
# GATE_CUSTOM_SETTINGS=1
# How long a bot "thinks" before a move, in milliseconds.
# BOT_DELAY_MIN_MS=500
# BOT_DELAY_MAX_MS=1100
# Quick match seats bots if nobody else has joined after this long.
# QUICK_MATCH_BOT_AFTER_MS=20000
# A live table hands an idle seat to a bot after this long.
# IDLE_TAKEOVER_MS=180000
# A finished game's move-by-move state is dropped after this long (the result is kept).
# WIPE_MATCH_AFTER_MS=600000
